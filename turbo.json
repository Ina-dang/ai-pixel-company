{
  "$schema": "https://turborepo.com/schema.json",
  "globalEnv": ["DATABASE_URL", "TEST_DATABASE_URL", "OWNER_BOOTSTRAP_HASH", "APP_ORIGIN", "API_PORT", "API_INTERNAL_URL", "E2E_OWNER_SECRET", "UI_BASE_URL", "PYTHON"],
  "tasks": {
    "typecheck": { "dependsOn": ["^typecheck"] },
    "build": { "dependsOn": ["^build"], "outputs": [], "env": ["API_INTERNAL_URL"] },
    "@ai-pixel/web#build": { "dependsOn": ["^build"], "outputs": [".next/**", "!.next/cache/**"], "env": ["API_INTERNAL_URL"] }
  }
}
